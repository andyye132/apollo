<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="edu.uw.ubicomp.apolloproto"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Passive eye tracking (All day): a camera foreground service with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Development permission for the thermistors, granted once over adb (build.sh does it on install). -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- Bluetooth LE to the WILD watch. No pairing; Android 12+ uses the scan/connect permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Calm sensing (RageSense): inaudible sonar through the speaker and microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Care: nearby hospitals, clinics and labs (approximate location, only while the app is open) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Care: product search (UPCitemdb), drug labels (openFDA), places and map tiles (OpenStreetMap). Readings never leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Spoken cues: apps targeting Android 11+ must declare the TTS engines they bind to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Care: open the delivery apps when installed (else their site inside Apollo). -->
        <package android:name="com.dd.doordash" />
        <package android:name="com.ubercab.eats" />
    </queries>

    <application
        android:label="Apollo"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Apollo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".HeartRateActivity" android:screenOrientation="portrait" />
        <activity android:name=".FeverActivity" android:screenOrientation="portrait" />
        <activity android:name=".BreathActivity" android:screenOrientation="portrait" />
        <!-- Steps and flights climbed all day (barometer + step detector, batched in the sensor hub). -->
        <service android:name=".AllDayService" android:exported="false" />
        <activity android:name=".WatchActivity" android:screenOrientation="portrait" />
        <activity android:name=".TouchLabActivity" android:screenOrientation="portrait" />
        <activity android:name=".CalmSenseActivity" android:screenOrientation="portrait" />
        <activity android:name=".CalibrateActivity" android:screenOrientation="portrait" />
        <service android:name=".EyeTrackingService" android:foregroundServiceType="camera" android:exported="false" />
    </application>
</manifest>
